# Hub-Dienst: Einstellungen (kopieren nach server/.env). Alles Weitere steht in SERVER.md.

# --- Azure-Anwendung (dieselbe App-Registrierung wie der Hub) ---
HUB_TENANT_ID=
HUB_CLIENT_ID=
# Client-Geheimnis der App-Registrierung („Zertifikate & Geheimnisse“). Nur hier, nie im Browser.
HUB_CLIENT_SECRET=
# Berechtigung, die der Hub für den Dienst anfordert (unter „Eine API verfügbar machen“ angelegt).
# Standard: api://<HUB_CLIENT_ID>/Laeufe.Ausfuehren
HUB_API_SCOPE=
# Graph-Berechtigungen, die der Dienst im Namen der Person nutzt, durch Leerzeichen getrennt.
# Standard: die sieben der Copilot-Chat-API plus Mail.Send, Chat.ReadWrite, ChatMessage.Send (Zustellung per E-Mail und Teams)
# sowie Calendars.Read, Team.ReadBasic.All, Channel.ReadBasic.All (eigene Termine, Teams-Chats und -Kanäle als Wissensquellen).
HUB_GRAPH_SCOPES=

# --- Betrieb ---
# Schlüssel für die verschlüsselte Ablage der Anmeldungen: 64 Hex-Zeichen, z. B. `openssl rand -hex 32`.
# Fehlt er, legt der Dienst beim ersten Start einen unter HUB_DATEN/schluessel.json an (dann mit sichern!).
HUB_SCHLUESSEL=
# Erlaubte Ursprünge für den Hub, wenn er NICHT vom Dienst selbst ausgeliefert wird (z. B. GitHub Pages), mit Komma.
HUB_URSPRUNG=
# Gleichzeitige Läufe (Standard 3), Aufbewahrung fertiger Läufe in Tagen (Standard 30)
HUB_PARALLEL=3
HUB_AUFBEWAHRUNG_TAGE=30
# Lernschicht: Rückmeldungen aus Fachexperten-Chats so lange behalten (Tage)
HUB_FEEDBACK_TAGE=90
# Git-Speicher: Apps, Rechte und Agenten liefert der Dienst frisch aus diesem Repository (owner/repo, Branch).
# HUB_GIT_TOKEN: GitHub-Token mit „Contents: Read and write“ für dieses Repository. Dann speichert der Dienst Apps für
# alle (mit Rechteprüfung); niemand braucht einen Token im Browser. Leer = ohne Token im Browser nur lesen.
HUB_GIT_REPO=
HUB_GIT_BRANCH=main
HUB_GIT_TOKEN=
# Chromium für Diagramme in Mail und Teams (im Container vorinstalliert). Leer = suchen, „aus“ = Diagramme als Quelltext.
HUB_CHROMIUM=
# Versionsangabe, die /api/dienst meldet (z. B. Datum oder Git-Stand)
HUB_VERSION=

# --- Nur zum Ausprobieren ohne Microsoft-Konto ---
# HUB_TESTMODUS=1  (Copilot-Attrappe, Anmeldung „Bearer test:<name>“; nie im Betrieb setzen)

# --- Hub (werden beim Bauen des Containers in die statischen Dateien übernommen) ---
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_GRAPH_SCOPES=
VITE_ADMINS=dario.keller@koerber.com
VITE_SP_ORDNER_URL=
