# Zentrale KI-Anbindung (Azure-Anwendung in Microsoft Entra ID)
# Ohne diese Werte läuft der KI-Hub im Simulationsmodus und zeigt die Anfragen an, statt sie zu senden.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
# Delegierte Graph-Berechtigungen, durch Leerzeichen getrennt. Leer lassen = die sieben, die die
# Copilot-Chat-API verlangt (Sites.Read.All, Mail.Read, People.Read.All, OnlineMeetingTranscript.Read.All,
# Chat.Read, ChannelMessage.Read.All, ExternalItem.Read.All), alle mit Administratorzustimmung.
VITE_GRAPH_SCOPES=

# Speicherort der Applikationen: local (dieser Browser) oder sharepoint
VITE_APP_STORE=local
# Nur bei sharepoint: Graph-ID der SharePoint-Website und Ordner in der Standardbibliothek
VITE_SP_SITE_ID=
VITE_SP_ORDNER=KI-Hub/apps
